# Environment variable template. Copy it to `.env` for local use:
#   cp .env.example .env
#
# Ollama model to download at startup.
# Options: gemma2:2b, gemma3:270m, gemma3:1b, gemma3:4b, llama3.2:3b, ...
OLLAMA_MODEL=llama3.2:3b

# BERT model for anonymization (gated Hugging Face repo).
# The local folder under models/ is the last part of the repo id.
BERT_MODEL=BSC-NLP4BIA/bsc-bio-ehr-es-carmen-anon

# Git revision (commit hash) of the BERT model repo, pinned for reproducibility.
BERT_MODEL_REVISION=83db1112c37c7ef527a9ba6d6b4d1be18b4bca9b

# SHA-256 of the BERT weights file. The local copy is `pytorch_model.bin`;
# verify_model_hash checks `model.safetensors` first, then `pytorch_model.bin`.
# The HF repo also publishes `model.safetensors` (LFS oid
# 883c7c2c63d01da8af3ea12a8b22237f2896b0ce). Pin the value that matches the
# file you actually keep.
BERT_MODEL_SHA256=a8b2976c284b72db42adf97df8d5a1609ca477f3abdae71a5d201d4d3ff89acd

# Public URL of the remote proxy (Sliplane) used by the local client.
REMOTE_URL=https://your-app.sliplane.app

# Local port where `local_ollama.py` mimics Ollama (default 11434).
LOCAL_PORT=11434

# Shared pre-shared key (PSK) for the client <-> server channel (protocol v2).
# Generate one with:  python -m src.keygen
# It is a base64 string that decodes to >= 32 random bytes. It must be the
# same on the client and the server. NOTE: PSK means no forward secrecy.
ENCRYPTION_SECRET=

# Credentials (user/password). They travel INSIDE the encrypted payload and are
# compared in constant time by the proxy. The proxy also verifies that
# OLLAMA_MODEL and BERT_MODEL match its own configuration; every value must
# coincide or the request is rejected. Leave empty to disable.
AUTH_USER=admin
AUTH_PASSWORD=

# Allowed IPs (comma-separated; CIDR supported). Empty = no restriction.
ALLOWED_IPS=

# Reverse proxies whose X-Forwarded-For header is trusted (comma-separated
# IPs/CIDRs). The proxy only honors X-Forwarded-For from these peers.
TRUSTED_PROXIES=

# Requests per minute allowed per client IP (0 = no limit).
RATE_LIMIT=0

# Maximum clock skew (seconds) accepted between client and server.
MAX_SKEW=120

# Anti-replay cache TTL (seconds). Must be >= 2 * MAX_SKEW; lower values are
# raised automatically.
REPLAY_TTL=300

# Maximum number of remembered request ids; the cache fails closed when full.
REPLAY_MAX_ENTRIES=100000

# Presidio (spaCy es_core_news_lg) como tercer componente del detector.
# Desactivado por defecto (0). Al activarlo (1), Presidio añade NAME/EMAIL/
# LOCATION sobre los huecos de BERT+regex: mejora la neutralización
# (90.8% -> 95.0% en MEDDOCAN dev) y reduce el leakage amplio (10.4% -> 8.4%),
# pero baja el F1 relajado (0.80 -> 0.75) por sobre-redacción. Útil si el
# texto de entrada no está pseudoanonimizado y se prioriza minimizar la fuga.
# Requiere presidio-analyzer y el modelo es_core_news_lg
# (ver requirements-client.txt).
PUKARA_ENABLE_PRESIDIO=0

# Optional JSON-lines audit log path (server side). Empty = disabled.
AUDIT_LOG=

# Maximum request body size in bytes (server side). Default 10 MB.
MAX_BODY_BYTES=10485760

# Timeout (seconds) for the upstream Ollama call.
UPSTREAM_TIMEOUT=600

# Maximum number of distinct client IPs tracked for rate limiting; the limiter
# fails closed when this is exceeded.
MAX_RATE_IPS=100000

# Allow Ollama model-management routes (pull/delete/create/copy/push) through
# the proxy. Disabled by default.
ALLOW_MANAGEMENT=0

# Refuse to start when ALLOWED_IPS or credentials are missing (fail-closed).
STRICT=0

